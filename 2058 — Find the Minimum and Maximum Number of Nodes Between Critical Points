
class Solution {
public:
    vector<int> nodesBetweenCriticalPoints(ListNode* head) {
        int first = -1;
        int last = -1;
        int minDist = INT_MAX;

        ListNode* prev = head;
        ListNode* curr = head->next;

        int index = 1;

        while (curr->next != nullptr) {
            int a = prev->val;
            int b = curr->val;
            int c = curr->next->val;

            // Local minimum OR local maximum
            if ((b < a && b < c) ||
                (b > a && b > c)) {

                if (first == -1) {
                    first = index;
                } else {
                    minDist = min(minDist, index - last);
                }

                last = index;
            }

            prev = curr;
            curr = curr->next;
            index++;
        }

        // Fewer than two critical points
        if (first == last)
            return {-1, -1};

        int maxDist = last - first;

        return {minDist, maxDist};
    }
};
