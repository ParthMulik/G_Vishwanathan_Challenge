class Solution {
public:
    bool sumGame(string num) {
        int n = num.size();
        int cnt1 = 0, cnt2 = 0;
        int sum1 = 0, sum2 = 0;

        for (int i = 0; i < n / 2; i++) {
            if (num[i] == '?')
                cnt1++;
            else
                sum1 += num[i] - '0';
        }

        for (int i = n / 2; i < n; i++) {
            if (num[i] == '?')
                cnt2++;
            else
                sum2 += num[i] - '0';
        }

        // Odd number of '?' -> Alice wins
        if ((cnt1 + cnt2) % 2)
            return true;

        // Bob can win only if the existing difference
        // can exactly be balanced by the '?'s.
        return sum1 - sum2 != 9 * (cnt2 - cnt1) / 2;
    }
};
